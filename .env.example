# ─────────────────────────────────────────────────────────────────────────────
# Video Streaming Server — configuration
# Copy to `.env` and adjust. All values have safe defaults (see src/config.ts).
# ─────────────────────────────────────────────────────────────────────────────

# HTTP server
PORT=3000
HOST=0.0.0.0
# Public base URL the player/clients use to reach this server (no trailing slash).
PUBLIC_BASE_URL=http://localhost:3000
LOG_LEVEL=info
# Pretty, human-readable logs (dev). Set to false for JSON logs in production.
LOG_PRETTY=true

# Auth
# CHANGE THIS in production — a long random string. Tokens are signed with it.
JWT_SECRET=dev-only-insecure-secret-change-me
ACCESS_TOKEN_TTL=15m
# Playback session lifetime. The session token guards the .m3u8 + segments.
SESSION_TTL=3h

# Catalog store: "sqlite" (better-sqlite3) or "json" (data/catalog.json).
# Falls back to "json" automatically if better-sqlite3 cannot be loaded.
CATALOG_STORE=sqlite
CATALOG_DB_PATH=data/catalog.db
CATALOG_JSON_PATH=data/catalog.json

# Paths
MEDIA_DIR=media
SESSIONS_DIR=data/sessions
FONTS_DIR=assets/fonts

# Optional: override the bundled ffmpeg/ffprobe (e.g. a system install with libass).
# Leave empty to use the binaries bundled by ffmpeg-static / ffprobe-static.
FFMPEG_PATH=
FFPROBE_PATH=

# Transcoding
# Max simultaneous ffmpeg burn-in jobs. Defaults to (CPU cores) when unset.
MAX_CONCURRENT_TRANSCODES=
HLS_SEGMENT_SECONDS=4
X264_PRESET=veryfast
X264_CRF=21
# Kill a session's ffmpeg if no segment has been fetched for this many seconds.
SESSION_IDLE_TIMEOUT_SEC=120
# How often the background sweeper reaps expired/idle sessions, seconds.
SWEEP_INTERVAL_SEC=30
# External (URL) sources are re-encoded with the watermark on the fly. Live or
# very long streams are capped to this many seconds so the burn-in stays finite.
EXTERNAL_MAX_SECONDS=120

# ─────────────────────────────────────────────────────────────────────────────
# Watermark (per-user, burned-in). Physical mm/cm cannot be honored literally in
# burned-in video (the server has no screen DPI), so sizes map to a fraction of
# the video frame. Defaults sit inside the requested ranges.
# ─────────────────────────────────────────────────────────────────────────────

# Text height as a fraction of video height (~"4-6 mm"). 0.035 = 3.5% of height.
WM_TEXT_HEIGHT_PCT=0.035
# Inset of the watermark from every border as a fraction of the dimension
# (~"1.5-2.5 cm gap"). 0.04 = 4%.
WM_GAP_PCT=0.04
# Opacity (0..1), ~"50%-75%". 0.65 = 65%.
WM_OPACITY=0.65
# Random reposition period bounds, seconds ("3-12 s").
WM_MIN_INTERVAL_SEC=3
WM_MAX_INTERVAL_SEC=12
# The watermark hugs a random border each interval: top/bottom render horizontally,
# left/right render VERTICALLY (rotated 90°/270°).
# Font file name inside FONTS_DIR used by libass for the burned-in text.
WM_FONT_NAME=DejaVu Sans
WM_FONT_FILE=DejaVuSans.ttf

# ─────────────────────────────────────────────────────────────────────────────
# Static logo watermark (also burned in, alongside the moving text). The moving
# text is steered away from the logo's corner so they never overlap.
# ─────────────────────────────────────────────────────────────────────────────

# Where the logo sits: disabled | top-left | top-right | bottom-left | bottom-right
LOGO_POSITION=bottom-right
# PNG or JPEG. Default is a bundled GitHub mark. Relative to project root or absolute.
LOGO_FILE=assets/logos/github.png
# Logo size: its larger side as a fraction of the SMALLER video dimension.
# Clamped to <= 0.125 (1/8), honoring "not over 1/8 of width (if portrait) / height (if landscape)".
LOGO_SIZE_PCT=0.10
# Gaps from the two nearest borders, as fractions of width/height. Range 0..0.10.
LOGO_GAP_X_PCT=0.03
LOGO_GAP_Y_PCT=0.03
# Logo opacity (0..1).
LOGO_OPACITY=0.85
